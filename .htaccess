RewriteEngine On

# API 리라이팅을 최우선으로 처리 (다른 리다이렉트보다 먼저)
RewriteRule ^api/community/?$ api/community.php [L,QSA]
RewriteRule ^api/job-board/?$ api/job-board.php [L,QSA]

# 구버전 URL을 새로운 creator 경로로 301 리다이렉트
RewriteRule ^community/?$ /creator/community [R=301,L]
RewriteRule ^community/([0-9]+)/?$ /creator/view-post?id=$1 [R=301,L,QSA]
RewriteRule ^write-post/?$ /creator/write-post [R=301,L]
RewriteRule ^job-board/?$ /creator/job-board [R=301,L]
RewriteRule ^job-board/([0-9]+)/?$ /creator/job-view?id=$1 [R=301,L,QSA]
RewriteRule ^write-job/?$ /creator/write-job [R=301,L,QSA]

# 정책 페이지를 creator 경로로 301 리다이렉트
RewriteRule ^terms/?$ /creator/terms [R=301,L]
RewriteRule ^privacy/?$ /creator/privacy [R=301,L]

# 기존 도구들을 creator 경로로 301 리다이렉트
RewriteRule ^kakao-chat/?$ /creator/kakao-chat [R=301,L]
RewriteRule ^thumbnail-text/?$ /creator/thumbnail-text [R=301,L]
RewriteRule ^obs-browser-source/?$ /creator/obs-browser-source [R=301,L]

# 호러 섹션 URL 라우팅
RewriteRule ^horror/?$ /horror/index.php [L]
RewriteRule ^horror/category/([a-zA-Z0-9-]+)/?$ /horror/category.php?category=$1 [L,QSA]
RewriteRule ^horror/write/?$ /horror/write.php [L]
RewriteRule ^horror/post/([0-9]+)/?$ /horror/post.php?id=$1 [L,QSA]

# 게임 섹션 URL 라우팅
RewriteRule ^game/?$ /game/index.php [L]
RewriteRule ^game/valorant/?$ /game/valorant/index.php [L]
RewriteRule ^game/valorant/board/?$ /game/valorant/board.php [L]
RewriteRule ^game/valorant/write/?$ /game/valorant/write.php [L]
RewriteRule ^game/valorant/post/([0-9]+)/?$ /game/valorant/post.php?id=$1 [L,QSA]

# www 없이 접근 시 www 추가 (선택사항)
# RewriteCond %{HTTP_HOST} !^www\. [NC]
# RewriteRule ^(.*)$ http://www.%{HTTP_HOST}/$1 [R=301,L]

# HTTPS 리다이렉트 (선택사항)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 파일 확장자 숨기기
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^([^\.]+)$ $1.php [NC,L]

# 보안 설정
<Files ".htaccess">
    Order allow,deny
    Deny from all
</Files>

# 브라우저 캐싱 설정
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
</IfModule>

# favicon 요청 처리 (로고로 리다이렉트)
RedirectMatch 302 ^/favicon\.ico$ /assets/images/jjapshoplogo.webp

# Gzip 압축
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
</IfModule>
